# At least one of the following needs to be set. Connectors whose env var is
# missing are quietly skipped by the registry.

ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5

GOOGLE_API_KEY=AIza...
# GOOGLE_MODEL=gemini-2.5-pro

# Qwen is served through Alibaba Cloud DashScope.
# International default: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Mainland:              https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-max

DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-reasoner

# Kimi is served by Moonshot.
# International default: https://api.moonshot.ai/v1
# Mainland:              https://api.moonshot.cn/v1
MOONSHOT_API_KEY=sk-...
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2
